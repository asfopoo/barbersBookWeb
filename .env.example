# Env vars are loaded by Vite based on mode.
# Precedence (first wins): .env.[mode].local > .env.[mode] > .env.local > .env
#
# `npm run dev`         → .env.development  (local API)
# `npm run dev:prod`    → .env.production   (dev server hitting prod API)
# `npm run build`       → .env.production   (prod API, default)
# `npm run build:local` → .env.development  (rare: build artifact hitting local API)
#
# For personal per-machine overrides without committing, create:
#   .env.local                 (any mode)
#   .env.development.local     (dev only)
#   .env.production.local      (build only)
# These are gitignored via `*.local` in .gitignore.

VITE_API_URL=http://localhost:4000
